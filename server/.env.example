NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Frontend Directory
FRONTEND_DIR=public

# URLs
PUBLIC_URL=http://127.0.0.1:3001
API_URL=http://127.0.0.1:3001

# CORS - Origenes Permitidos (comma-separated). Vacío = solo same-origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

# Reverse Proxy Settings
TRUST_PROXY=true

# Base de datos (producción: credenciales reales en server/.env, NO en repo)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=byma_dashboard
DB_PORT=3306

# Auth - OBLIGATORIO: secreto aleatorio de >= 32 caracteres. NO fallbacks.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_para_un_secreto_aleatorio_largo_>=_32_caracteres

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NVIDIA IA (Nemotron)
NVIDIA_API_KEY=